# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional Codex CLI fallback model; omit to use the authenticated CLI default.
# ROSCLAW_CODEX_REVIEW_MODEL=gpt-5

# GitHub API Configuration
GITHUB_TOKEN=your_github_personal_access_token_here

# Rosclaw Site API
ROSCLAW_API_KEY=your_rosclaw_admin_api_key_here
ROSCLAW_BASE_URL=https://www.rosclaw.io

# Optional: Aliyun Bailian (for alternative LLM analysis)
BAILIAN_API_KEY=your_bailian_api_key_here
